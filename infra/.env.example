# HyperDesign Docker Compose 环境变量配置

# MySQL 数据库密码
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_PASSWORD=your_secure_password_here
# Only exposed on localhost for development and host-side integration tests.
# Production deployments should remove the mysql ports section from Compose.
MYSQL_HOST_PORT=3306

# Web 前端端口
WEB_PORT=8080

# 前端访问地址（用于 CORS 和 Cookie）
APP_ORIGIN=http://localhost:8080

# Session Cookie 安全标志（生产环境使用 HTTPS 时设为 true）
SESSION_COOKIE_SECURE=false

# 最大上传大小（字节，默认 100MB）
MAX_UPLOAD_BYTES=104857600

# 文件存储宿主机路径
# 开发环境可使用相对路径：./storage
# 生产环境建议使用绝对路径：/opt/hyperdesign/data/storage
STORAGE_HOST_PATH=./storage
