# HyperDesign Docker Compose 环境变量配置

# MySQL 数据库密码
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# Only used by docker-compose.dev.yml for host-side development and integration tests.
# The default production Compose does not publish a MySQL host port.
MYSQL_HOST_PORT=3306

# Web 前端监听地址和端口。生产环境保持回环地址，由 Caddy/Nginx 代理。
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# 前端访问地址（用于 CORS 和 Cookie）
APP_ORIGIN=http://localhost:8080

# Session Cookie 安全标志（生产环境使用 HTTPS 时设为 true）
SESSION_COOKIE_SECURE=false

# 最大上传大小（字节，默认 100MB）
MAX_UPLOAD_BYTES=104857600

# 文件存储宿主机路径
# 开发环境可使用相对路径：./storage
# 生产环境建议使用绝对路径：/opt/hyperdesign/data/storage
STORAGE_HOST_PATH=./storage
