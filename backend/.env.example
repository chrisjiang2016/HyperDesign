# 数据库连接
# 本地开发：mysql://hyperdesign:dev_password@localhost:3306/hyperdesign
# Docker 环境：mysql://hyperdesign:${MYSQL_PASSWORD}@mysql:3306/hyperdesign
DATABASE_URL="mysql://hyperdesign:your_password@localhost:3306/hyperdesign"

# 应用配置
PORT=3000
APP_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
SESSION_COOKIE_SECURE=false

# 文件存储
# 本地开发：./storage（相对于 backend 目录）
# Docker 环境：/app/storage（容器内路径，映射到宿主机 /opt/hyperdesign/data/storage）
STORAGE_LOCAL_ROOT=./storage
MAX_UPLOAD_BYTES=104857600

# 生产环境预留（暂未实现）
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://minio:9000
S3_BUCKET=hyperdesign
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
