# HyperDesign Backend — Example Environment Variables
# Copy this file to .env and fill in real values before running the stack.

# ── Application ──────────────────────────────────────────────────
# HTTP port the NestJS API listens on inside the container.
PORT=3000

# Public origin of the web frontend, used to configure CORS.
# In Docker Compose: http://localhost:8080
APP_ORIGIN=http://localhost:8080

# ── Session ──────────────────────────────────────────────────────
# Long random string used to sign session cookies.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret

# Set to "true" when the app runs behind HTTPS.
SESSION_COOKIE_SECURE=false

# ── Database ─────────────────────────────────────────────────────
# SQLite is the default for single-node Docker deployments.
# To switch to PostgreSQL, update prisma/schema.prisma and point here:
# DATABASE_URL="postgresql://user:password@host:5432/hyperdesign"
DATABASE_URL="file:./dev.db"

# ── Storage ──────────────────────────────────────────────────────
# Local directory for prototype ZIP uploads and extracted HTML.
STORAGE_LOCAL_ROOT=./storage

# Maximum ZIP upload size in bytes (default 100 MiB).
MAX_UPLOAD_BYTES=104857600

# ── Optional: Redis & MinIO (future) ─────────────────────────────
# Redis session store (to enable, install ioredis and connect-redis).
# REDIS_URL=redis://redis:6379

# S3-compatible object storage (to enable, update StorageService).
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=hyperdesign
# S3_ACCESS_KEY=replace-me
# S3_SECRET_KEY=replace-me
