# Root ignores — build artifacts, environment secrets, local data & OS files

# Dependencies
node_modules/

# Build output
dist/
dist-seed/

# Environment secrets — only .env.example is committed
.env
.env.local
.env.*.local

# Databases (local / test)
*.db
*.db-journal

# Uploaded prototypes & extracted preview resources
storage/
data/

# The backend StorageService is source code, not uploaded prototype data.
!backend/src/
!backend/src/storage/
!backend/src/storage/**

# Docker volumes (do not commit real data)
volumes/

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*

# Test
coverage/
test-results/
playwright-report/

# Temporary files
*.tmp
*.temp

# WorkBuddy project memory and configuration
.workbuddy/

# OpenClaw historical memory (not version controlled)
memory/
*.rar
test resources/
.env.production
.env.production.fixed
frontend/frontend-dist.tar.gz
~$*

# Test files and scripts
test-*.html
test-*.py
test-*.js
test-automation.js
test-screenshots/
test-cases-*.md
test-plan.md
test-report-*.md
build_testcases*.py
encode_file.py
hyperdesign-test-page.html
统一账户流水查询.html
*.xlsx

# Deployment scripts and bundles
deploy-*.sh
update-*.sh
*.bundle
部署指南-*.md
部署指南-*.md

# Build outputs and generated artifacts
outputs/
frontend/start-dev.bat

# Nginx config (managed separately on server)
nginx-hyperdesign.conf

